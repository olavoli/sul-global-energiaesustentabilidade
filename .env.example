# Public environment: development, preview, staging, production or test.
# A generic build defaults to preview. Production must be explicit.
VITE_APP_ENV=development

# Public URL used in metadata and absolute links. This is not a secret.
VITE_PUBLIC_SITE_URL=http://localhost:8080

# Production hides demo articles by default. Set true only for an explicit demo deployment.
VITE_ALLOW_DEMO_CONTENT=false
