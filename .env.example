# Public environment: development, preview, staging, production or test.
# A generic build defaults to preview. Production must be explicit.
VITE_APP_ENV=development

# Public URL used in metadata and absolute links. This is not a secret.
VITE_PUBLIC_SITE_URL=http://localhost:8080

# Production hides demo articles by default. Set true only for an explicit demo deployment.
VITE_ALLOW_DEMO_CONTENT=false

# Newsroom automation is fail-safe. Apply requires explicit enablement.
NEWSROOM_ENABLED=false
NEWSROOM_COLLECTION_ENABLED=false
NEWSROOM_TRANSLATION_ENABLED=false
NEWSROOM_ORCHESTRATION_ENABLED=false
NEWSROOM_NOTIFICATIONS_ENABLED=false
NEWSROOM_SCHEDULE_ENABLED=false

# Segredo somente do servidor. Defina o valor real fora do repositório.
NEWSROOM_ADMIN_SECRET=
# Permite sessão sem cookie Secure apenas em desenvolvimento local explícito.
NEWSROOM_ADMIN_LOCAL=false

# Persistência operacional. Produção exige durable e binding NEWSROOM_DB server-side.
NEWSROOM_STORAGE_DRIVER=local
NEWSROOM_ENVIRONMENT=development

# Smoke remoto de staging. Deixe vazio localmente; use variables/secrets protegidos.
STAGING_BASE_URL=
STAGING_ADMIN_SECRET=
STAGING_TARGET_CONFIRMATION=
# Guard opcional para impedir que o smoke de staging use a origem de produção.
PRODUCTION_BASE_URL=
